{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/pinnacle-pis run build",
  "outputDirectory": "artifacts/pinnacle-pis/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
